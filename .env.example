# Copy this file to ".env" and change the values

PORT=3000

# Username & password for the /admin.html panel (HTTP Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-123

# Secret used to sign customer login sessions (JWT). Use a long random string
# in production — e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-to-a-long-random-string
